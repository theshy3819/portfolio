{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "industry": {
      "type": "string"
    },
    "layout": {
      "type": "string",
      "description": "청사진의 레이아웃 id. 예: c1"
    },
    "theme": {
      "type": "string",
      "enum": [
        "clearWater",
        "roseMosaic",
        "yellowSign",
        "facilityWalk",
        "inkNavy",
        "stonePaper"
      ]
    },
    "business": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "kind": {
          "type": "string",
          "maxLength": 30,
          "description": "업종 표기. 예: 예약제 1인 피부관리실"
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "maxLength": 80
        },
        "addressNote": {
          "description": "주차·층수 등",
          "type": "string",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "maxLength": 60
        },
        "hours": {
          "minItems": 7,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "wd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6,
                "description": "0=일 … 6=토"
              },
              "open": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "null 이면 정기 휴무"
              },
              "close": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lunch": {
                "description": "이 요일에 점심시간이 있는지",
                "type": "boolean"
              }
            },
            "required": [
              "wd",
              "open",
              "close"
            ]
          }
        },
        "lunch": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "closedDates": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "label": {
                "type": "string",
                "maxLength": 20
              }
            },
            "required": [
              "date",
              "label"
            ]
          }
        },
        "offerings": {
          "default": [],
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "desc": {
                "type": "string",
                "maxLength": 60
              },
              "price": {
                "description": "사장님이 준 값 그대로. 예: 60,000원",
                "type": "string",
                "maxLength": 20
              },
              "time": {
                "type": "string",
                "maxLength": 20
              },
              "badge": {
                "type": "string",
                "maxLength": 10
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "people": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "role": {
                "type": "string",
                "maxLength": 30
              },
              "lines": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 60
                },
                "description": "학력·경력·자격 등 사실 줄"
              },
              "photo": {
                "type": "object",
                "properties": {
                  "hint": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 60,
                    "description": "이 칸에 들어갈 사진 설명. 예: 창가 햇살이 드는 관리실"
                  },
                  "src": {
                    "type": "string"
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 120
                  }
                },
                "required": [
                  "hint"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "lines"
            ]
          }
        },
        "registration": {
          "description": "사업자·개설 신고 등 푸터 표기",
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "name",
        "kind",
        "phone",
        "address",
        "hours"
      ]
    },
    "sections": {
      "minItems": 3,
      "maxItems": 16,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
